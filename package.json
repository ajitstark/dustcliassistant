{
  "name": "dev-assistant",
  "version": "0.1.0",
  "description": "Production-grade AI-powered debugging CLI assistant",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dev-assistant": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "workers": "node dist/workers.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v",
    "prepare": "husky"
  },
  "dependencies": {
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "boxen": "^7.1.1",
    "bullmq": "^5.17.0",
    "chalk": "^5.3.0",
    "chromadb": "^1.10.4",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "inquirer": "^10.2.2",
    "ioredis": "^5.4.1",
    "ora": "^8.0.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "ws": "^8.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "@eslint/js": "^9.10.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "globals": "^15.11.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier -w"
    ]
  }
}
