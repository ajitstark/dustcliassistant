# AI provider: "openai" (default) or "gemini" (via custom adapter)
AI_PROVIDER=openai
OPENAI_API_KEY=your_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini
GEMINI_API_KEY=your_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# GitHub Models (https://models.github.ai)
# Create a PAT with Models access (classic: `models` scope; fine-grained: Models read).
GITHUB_MODELS_TOKEN=your_github_pat
# Example model IDs: openai/gpt-4.1, openai/gpt-4o, openai/gpt-4o-mini, meta/llama-3.1-70b-instruct, deepseek/deepseek-r1
GITHUB_MODELS_MODEL=openai/gpt-4.1
# Optional: attribute usage to an org (must be a member and org must enable models)
# GITHUB_MODELS_ORG=your-org
# Optional: override API version header
# GITHUB_API_VERSION=2026-03-10

# Redis (BullMQ + realtime)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Postgres (Prisma)
DATABASE_URL=postgresql://devassistant:devassistant@localhost:5432/devassistant?schema=public

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=dev_assistant_memory

# WebSocket server
WS_PORT=7337

# Feature flags
ENABLE_EMBEDDINGS=true
ENABLE_MEMORY=true
ENABLE_REALTIME=true
